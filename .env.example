# Configuration locale Valmora — ne pas partager ni versionner ce fichier.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase : renseigner les trois valeurs du projet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement, ne jamais utiliser de préfixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Administration : définir un mot de passe fort et un secret aléatoire (32 caractères minimum).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Alertes e-mail Gmail : adresse, mot de passe d’application et destinataire.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL=

# Stripe (optionnel).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
